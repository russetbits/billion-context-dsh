# Bare name (no trailing slash) so a file or symlink named node_modules is
# ignored too — `node_modules/` only matches directories, which let an
# accidentally committed machine-specific symlink through (PR #207 review).
node_modules
*.log
.DS_Store

# Worktrees (local development only, never push)
worktrees/

# Scratch / planning files (local only, never push)
scratch-*
docs/fix-issue-*-plan.md
docs/video-script.md
.npm-cache/

# pnpm scratch from local builds (this repo ships package-lock.json)
.pnpm-store/
pnpm-lock.yaml

# Local-only working artifacts (never push)
scripts/e2e/out/
dsh-routing-suite/
.agent-teams/
0001-*.patch
压缩的仓库用法.txt

# Scratch directory for agent/teammate intermediate files (commit-msg drafts,
# schema dumps, file backups, benchmark output). Local only — a `git add -A`
# must never sweep these into a public repo.
.tmp/
